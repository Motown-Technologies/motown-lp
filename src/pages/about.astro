---
import BaseLayout from "../layouts/BaseLayout.astro";

import { Image } from "astro:assets";

import choiceImage from "../img/modern-technology-workspace-with-multiple-monitors.jpg";
import storyImage from "../img/professional-team-collaborating-on-technology-proj.jpg";
---

<BaseLayout>
    <main class="min-h-screen bg-[#0a0a0f]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] via-[#1a1a2e] to-[#0a0a0f] pt-8 pb-32"
        >
            <div class="max-w-7xl mx-auto px-6">
                <!-- Hero Content -->
                <div class="max-w-4xl mx-auto text-center mb-24">
                    <div class="inline-block mb-6">
                        <span
                            class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                            >About Us</span
                        >
                    </div>
                    <h1
                        class="text-6xl md:text-7xl lg:text-8xl font-bold text-white mb-8 leading-tight text-balance"
                    >
                        Where Ideas Become Reality
                    </h1>
                    <p
                        class="text-xl text-gray-400 leading-relaxed text-pretty"
                    >
                        At Motown Tech, we are passionate about crafting
                        innovative digital solutions that drive businesses
                        forward. Our team blends technical expertise with a
                        creative flair, delivering cutting-edge solutions that
                        exceed expectations.
                    </p>
                </div>

                <!-- Process Timeline -->
                <div class="max-w-6xl mx-auto">
                    <div class="text-center mb-16">
                        <h3 class="text-3xl font-bold text-white mb-4">
                            How We Deliver
                        </h3>
                        <p class="text-gray-400 text-lg leading-relaxed">
                            A proven four-stage rhythm that keeps every project
                            aligned, transparent, and moving with intent.
                        </p>
                    </div>
                    <div class="grid gap-10 lg:grid-cols-4">
                        <div
                            class="group relative h-full rounded-2xl border border-gray-800 bg-[#111122] p-8 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/60 hover:shadow-[0_25px_50px_rgba(37,99,235,0.2)]"
                        >
                            <div
                                class="mb-6 text-sm uppercase tracking-wide text-gray-500"
                            >
                                Set the Vision
                            </div>
                            <h4
                                class="text-2xl font-semibold mb-4 bg-gradient-to-r from-white via-white to-[#66a8ff] bg-clip-text text-transparent"
                            >
                                Discovery &amp; Immersion
                            </h4>
                            <p class="text-gray-400 leading-relaxed">
                                Stakeholder interviews, audits, and rapid
                                workshops uncover goals, constraints, and the
                                opportunities that matter most.
                            </p>
                        </div>
                        <div
                            class="group relative h-full rounded-2xl border border-gray-800 bg-[#111122] p-8 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/60 hover:shadow-[0_25px_50px_rgba(37,99,235,0.2)]"
                        >
                            <div
                                class="mb-6 text-sm uppercase tracking-wide text-gray-500"
                            >
                                Design Together
                            </div>
                            <h4
                                class="text-2xl font-semibold mb-4 bg-gradient-to-r from-white via-white to-[#66a8ff] bg-clip-text text-transparent"
                            >
                                Co-Design &amp; Prototyping
                            </h4>
                            <p class="text-gray-400 leading-relaxed">
                                We shape journeys, architectures, and clickable
                                prototypes so stakeholders can see, feel, and
                                refine the experience early.
                            </p>
                        </div>
                        <div
                            class="group relative h-full rounded-2xl border border-gray-800 bg-[#111122] p-8 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/60 hover:shadow-[0_25px_50px_rgba(37,99,235,0.2)]"
                        >
                            <div
                                class="mb-6 text-sm uppercase tracking-wide text-gray-500"
                            >
                                Ship With Confidence
                            </div>
                            <h4
                                class="text-2xl font-semibold mb-4 bg-gradient-to-r from-white via-white to-[#66a8ff] bg-clip-text text-transparent"
                            >
                                Build &amp; Launch
                            </h4>
                            <p class="text-gray-400 leading-relaxed">
                                Cross-functional squads ship in iterative
                                sprints, pairing automation with rigorous QA for
                                smooth releases.
                            </p>
                        </div>
                        <div
                            class="group h-full rounded-2xl border border-gray-800 bg-[#111122] p-8 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/60 hover:shadow-[0_25px_50px_rgba(37,99,235,0.2)]"
                        >
                            <div
                                class="mb-6 text-sm uppercase tracking-wide text-gray-500"
                            >
                                Scale &amp; Optimize
                            </div>
                            <h4
                                class="text-2xl font-semibold mb-4 bg-gradient-to-r from-white via-white to-[#66a8ff] bg-clip-text text-transparent"
                            >
                                Growth &amp; Optimization
                            </h4>
                            <p class="text-gray-400 leading-relaxed">
                                Post-launch analytics, experiments, and
                                enablement keep the solution evolving and your
                                team fully equipped.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Our Story -->
        <section class="py-24 bg-[#0a0a0f]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div>
                        <h2
                            class="text-4xl md:text-5xl font-bold text-white mb-6"
                        >
                            Our Story
                        </h2>
                        <div class="space-y-4 text-gray-400 leading-relaxed">
                            <p>
                                At Motown Tech, we are passionate about crafting
                                innovative digital solutions that drive
                                businesses forward. Our team blends technical
                                expertise with a creative flair, delivering
                                cutting-edge websites, custom software
                                solutions, and automation tools that not only
                                meet the unique needs of our clients but also
                                exceed their expectations.
                            </p>
                            <p>
                                We take pride in creating solutions that empower
                                businesses to thrive in today's competitive
                                landscape. Our approach is centered around
                                collaboration and understanding the distinct
                                challenges and opportunities within each
                                industry we serve.
                            </p>
                            <p>
                                Whether you're a startup looking to establish a
                                strong online presence or an established
                                enterprise seeking to optimize your operations
                                through automation, Motown Tech is your trusted
                                partner. We are committed to delivering
                                solutions that are as dynamic and diverse as the
                                clients we work with, ensuring that every
                                project is a harmonious blend of functionality,
                                innovation, and style.
                            </p>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                        >
                            <Image
                                src={storyImage}
                                alt="Motown Tech Team"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Our Values -->
        <section class="py-24 bg-[#1a1a2e]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                        Our Core Values
                    </h2>
                    <p
                        class="text-xl text-gray-400 max-w-3xl mx-auto text-pretty"
                    >
                        The principles that guide everything we do
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <!-- Innovation -->
                    <div
                        class="bg-[#0a0a0f] rounded-xl p-8 border border-gray-800"
                    >
                        <div
                            class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6"
                        >
                            <!-- lightbulb -->
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 18h6M10 22h4M7 9a5 5 0 1110 0c0 2.5-1.5 3.5-2 5H9c-.5-1.5-2-2.5-2-5z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">
                            Innovation
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            We constantly push boundaries and embrace new
                            technologies to deliver cutting-edge solutions
                        </p>
                    </div>

                    <!-- Excellence -->
                    <div
                        class="bg-[#0a0a0f] rounded-xl p-8 border border-gray-800"
                    >
                        <div
                            class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6"
                        >
                            <!-- award -->
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M8 21v-4a4 4 0 118 0v4l-4-2-4 2zM12 3a5 5 0 100 10 5 5 0 000-10z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">
                            Excellence
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            We strive for perfection in every project, ensuring
                            quality and attention to detail
                        </p>
                    </div>

                    <!-- Collaboration -->
                    <div
                        class="bg-[#0a0a0f] rounded-xl p-8 border border-gray-800"
                    >
                        <div
                            class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6"
                        >
                            <!-- users -->
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 20v-2a4 4 0 00-4-4H7a4 4 0 00-4 4v2M13 7a4 4 0 11-8 0 4 4 0 018 0M21 20v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">
                            Collaboration
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            We work closely with our clients as partners to
                            understand and achieve their goals
                        </p>
                    </div>

                    <!-- Results-Driven -->
                    <div
                        class="bg-[#0a0a0f] rounded-xl p-8 border border-gray-800"
                    >
                        <div
                            class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6"
                        >
                            <!-- target -->
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 8v4l3 3M12 22C6.48 22 2 17.52 2 12S6.48 2 12 2s10 4.48 10 10-4.48 10-10 10z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold text-white mb-3">
                            Results-Driven
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            We focus on delivering measurable outcomes that
                            drive real business value
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Why Choose Us -->
        <section class="py-24 bg-[#0a0a0f]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="relative">
                        <div
                            class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                        >
                            <Image
                                src={choiceImage}
                                alt="Technology Workspace"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>

                    <div>
                        <h2
                            class="text-4xl md:text-5xl font-bold text-white mb-6"
                        >
                            Why Choose Motown Tech?
                        </h2>
                        <p
                            class="text-xl text-gray-400 mb-8 leading-relaxed text-pretty"
                        >
                            We combine technical expertise with creative
                            innovation to deliver solutions that exceed
                            expectations
                        </p>

                        <div class="space-y-6">
                            <!-- Item -->
                            <div class="flex gap-4">
                                <div class="flex-shrink-0">
                                    <!-- check -->
                                    <svg
                                        class="w-6 h-6 text-[#2563eb]"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Expert Team
                                    </h3>
                                    <p class="text-gray-400 leading-relaxed">
                                        Skilled professionals with years of
                                        experience in cutting-edge technologies
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div class="flex-shrink-0">
                                    <svg
                                        class="w-6 h-6 text-[#2563eb]"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Proven Track Record
                                    </h3>
                                    <p class="text-gray-400 leading-relaxed">
                                        Successfully delivered projects across
                                        various industries
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div class="flex-shrink-0">
                                    <svg
                                        class="w-6 h-6 text-[#2563eb]"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Agile Approach
                                    </h3>
                                    <p class="text-gray-400 leading-relaxed">
                                        Flexible methodologies that adapt to
                                        your changing needs and priorities
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div class="flex-shrink-0">
                                    <svg
                                        class="w-6 h-6 text-[#2563eb]"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Ongoing Support
                                    </h3>
                                    <p class="text-gray-400 leading-relaxed">
                                        Dedicated maintenance and support to
                                        ensure your success long-term
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div class="flex-shrink-0">
                                    <svg
                                        class="w-6 h-6 text-[#2563eb]"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-white mb-2"
                                    >
                                        Client-Focused
                                    </h3>
                                    <p class="text-gray-400 leading-relaxed">
                                        Your success is our priority - we're
                                        committed to understanding and achieving
                                        your goals
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 bg-gradient-to-b from-[#1a1a2e] to-[#0a0a0f]">
            <div class="max-w-4xl mx-auto px-6 text-center">
                <h2
                    class="text-4xl md:text-5xl font-bold text-white mb-6 text-balance"
                >
                    Ready to Work Together?
                </h2>
                <p
                    class="text-xl text-gray-400 mb-10 leading-relaxed text-pretty"
                >
                    Let's collaborate to create something extraordinary. Get in
                    touch with our team today and start your journey to digital
                    success.
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="/contact"
                        class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors inline-flex items-center gap-2"
                    >
                        Contact Us
                        <!-- arrow-right -->
                        <svg
                            class="w-5 h-5"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M5 12h14M12 5l7 7-7 7"></path>
                        </svg>
                    </a>
                    <a
                        href="/services"
                        class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
                    >
                        View Our Services
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
