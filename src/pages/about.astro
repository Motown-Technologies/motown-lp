---
import BaseLayout from "../layouts/BaseLayout.astro";

const process = [
    {
        eyebrow: "Set the Vision",
        title: "Discovery & Immersion",
        body: "Stakeholder interviews, audits, and rapid workshops uncover goals, constraints, and the opportunities that matter most.",
    },
    {
        eyebrow: "Design Together",
        title: "Co-Design & Prototyping",
        body: "We shape journeys, architectures, and clickable prototypes so stakeholders can see, feel, and refine the experience early.",
    },
    {
        eyebrow: "Ship With Confidence",
        title: "Build & Launch",
        body: "Cross-functional squads ship in iterative sprints, pairing automation with rigorous QA for smooth releases.",
    },
    {
        eyebrow: "Scale & Optimize",
        title: "Growth & Optimization",
        body: "Post-launch analytics, experiments, and enablement keep the solution evolving and your team fully equipped.",
    },
];

const values = [
    {
        title: "Innovation",
        body: "We constantly push boundaries and embrace new technologies to deliver cutting-edge solutions.",
    },
    {
        title: "Excellence",
        body: "We strive for perfection in every project, ensuring quality and attention to detail.",
    },
    {
        title: "Collaboration",
        body: "We work closely with our clients as partners to understand and achieve their goals.",
    },
    {
        title: "Results-Driven",
        body: "We focus on delivering measurable outcomes that drive real business value.",
    },
];

const reasons = [
    {
        title: "Expert Team",
        body: "Skilled professionals with years of experience in cutting-edge technologies.",
    },
    {
        title: "Proven Track Record",
        body: "Successfully delivered projects across various industries.",
    },
    {
        title: "Agile Approach",
        body: "Flexible methodologies that adapt to your changing needs and priorities.",
    },
    {
        title: "Ongoing Support",
        body: "Dedicated maintenance and support to ensure your success long-term.",
    },
    {
        title: "Client-Focused",
        body: "Your success is our priority — we're committed to understanding and achieving your goals.",
    },
];
---

<BaseLayout
    meta_title="About Motown Solutions"
    meta_description="Learn how Motown Solutions blends strategy, design, and engineering to deliver modern digital experiences."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <div class="flex items-center gap-3 mb-8">
                        <span
                            aria-hidden
                            class="inline-block w-8 h-px bg-ink"></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >About / The Agency</span
                        >
                    </div>
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        An agency for
                        <br />
                        modern <span class="italic text-accent">ideas</span>.
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        At Motown Solutions, we craft innovative digital solutions
                        that drive businesses forward. We blend technical
                        expertise with creative flair — delivering cutting-edge
                        solutions that exceed expectations.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <div class="flex items-center gap-3 mb-5">
                        <span
                            aria-hidden
                            class="inline-block w-8 h-px bg-ink"></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >How We Deliver</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        A proven four-stage rhythm.
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Every project stays aligned, transparent, and moving
                        with intent — from first conversation through launch
                        and beyond.
                    </p>
                </div>
            </div>
            <div
                class="grid gap-0 md:grid-cols-4 border border-ink"
            >
                {
                    process.map((step) => (
                        <div class="p-8 md:p-10 border-ink border-b md:border-b-0 md:border-r last:border-r-0 last:border-b-0">
                            <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-6">
                                {step.eyebrow}
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-4">
                                {step.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {step.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Our Story -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 md:gap-12">
                <aside class="col-span-12 md:col-span-4">
                    <div class="flex items-center gap-3 mb-5">
                        <span
                            aria-hidden
                            class="inline-block w-8 h-px bg-ink"></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Our Story</span
                        >
                    </div>
                    <blockquote
                        class="font-mono text-sm leading-[1.7] text-ink-muted border-l border-ink/30 pl-5 max-w-xs"
                    >
                        "Our approach is centered around collaboration — and
                        understanding the distinct challenges and opportunities
                        within each industry we serve."
                    </blockquote>
                </aside>

                <div class="col-span-12 md:col-span-8">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance mb-8"
                    >
                        We're the partner
                        <br />
                        behind the product.
                    </h2>
                    <div class="space-y-5 text-ink-muted leading-relaxed text-lg max-w-2xl">
                        <p>
                            At Motown Solutions, we are passionate about crafting
                            innovative digital solutions that drive businesses
                            forward. Our team blends technical expertise with a
                            creative flair, delivering cutting-edge websites,
                            custom software solutions, and automation tools
                            that meet the unique needs of our clients and
                            exceed their expectations.
                        </p>
                        <p>
                            We take pride in creating solutions that empower
                            businesses to thrive in today's competitive
                            landscape. Our approach is centered around
                            collaboration and understanding the distinct
                            challenges and opportunities within each industry
                            we serve.
                        </p>
                        <p>
                            Whether you're a startup looking to establish a
                            strong online presence or an established enterprise
                            seeking to optimize your operations through
                            automation, Motown Solutions is your trusted partner.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Values -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <div class="flex items-center gap-3 mb-5">
                        <span
                            aria-hidden
                            class="inline-block w-8 h-px bg-ink"></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Core Values</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        The principles
                        <br />
                        that guide us.
                    </h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 border border-ink">
                {
                    values.map((v) => (
                        <div class="p-8 md:p-10 border-ink border-b md:[&:nth-child(odd)]:border-r md:[&:nth-child(n+3)]:border-b-0 last:border-b-0">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {v.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {v.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <div class="flex items-center gap-3 mb-5">
                        <span
                            aria-hidden
                            class="inline-block w-8 h-px bg-ink"></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Why Motown Solutions</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Technical expertise,
                        <br />
                        creative conviction.
                    </h2>
                </div>
            </div>

            <div class="border border-ink">
                {
                    reasons.map((r) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-7 md:py-8 px-6 md:px-8 border-b border-ink last:border-b-0">
                            <h3 class="col-span-12 md:col-span-5 font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight">
                                {r.title}
                            </h3>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed">
                                {r.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA — inverted -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <div class="flex items-center gap-3 mb-8">
                <span
                    aria-hidden
                    class="inline-block w-8 h-px bg-paper"></span>
                <span
                    class="font-mono text-xs uppercase tracking-eyebrow text-paper/60"
                    >Let's Work Together</span
                >
            </div>
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Ready to work
                <br />
                <span class="italic text-accent">together</span>?
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Let's collaborate to create something extraordinary. Get in
                touch and start your journey to digital success.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Contact Us
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View Our Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
