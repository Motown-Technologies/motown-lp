---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <main
        class="min-h-screen bg-[#0a0a0f] flex items-center justify-center px-6"
    >
        <div class="max-w-4xl mx-auto text-center">
            <!-- 404 Large Text -->
            <div class="mb-8">
                <h1
                    class="text-[clamp(6rem,16vw,18rem)] font-black leading-none text-white/20 drop-shadow-[0_0_50px_rgba(37,99,235,0.35)]"
                >
                    <span
                        class="inline-block bg-gradient-to-b from-[#4f8bfd] via-[#2563eb] to-[#0f172a] bg-clip-text text-transparent"
                    >
                        404
                    </span>
                </h1>
            </div>

            <!-- Error Message -->
            <div class="mb-12">
                <h2
                    class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 text-balance"
                >
                    Oops! Page Not Found
                </h2>
                <p
                    class="text-xl text-gray-400 leading-relaxed max-w-2xl mx-auto text-pretty"
                >
                    The page you're looking for seems to have wandered off into
                    the digital void. Don't worry, we'll help you get back on
                    track.
                </p>
            </div>

            <!-- Action Buttons -->
            <div
                class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16"
            >
                <a
                    href="/"
                    class="w-full sm:w-auto min-w-[230px] px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg inline-flex items-center justify-center gap-2 text-center transition-transform duration-200 border-2 border-transparent hover:bg-[#1d4ed8] hover:-translate-y-0.5"
                >
                    <!-- Home icon -->
                    <svg
                        class="w-5 h-5 flex-shrink-0"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M3 10.5 12 3l9 7.5"></path>
                        <path d="M5 9v12h14V9"></path>
                        <path d="M10 21v-6h4v6"></path>
                    </svg>
                    Back to Home
                </a>

                <a
                    href="/services"
                    class="w-full sm:w-auto min-w-[230px] px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg inline-flex items-center justify-center gap-2 text-center transition-transform duration-200 hover:bg-white/10 hover:-translate-y-0.5"
                >
                    <!-- Search icon -->
                    <svg
                        class="w-5 h-5 overflow-visible flex-shrink-0"
                        viewBox="-1 -1 26 26"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="M21 21l-4.35-4.35"></path>
                    </svg>
                    Browse Services
                </a>
            </div>

            <!-- Quick Links -->
            <div
                class="bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 max-w-2xl mx-auto"
            >
                <h3 class="text-xl font-bold text-white mb-6">Popular Pages</h3>
                <div class="grid sm:grid-cols-2 gap-4">
                    <a
                        href="/services/software-development"
                        class="text-left p-4 rounded-lg bg-[#0a0a0f]/50 hover:bg-[#0a0a0f] transition-colors group"
                    >
                        <div class="flex items-center justify-between">
                            <span
                                class="text-gray-300 group-hover:text-[#2563eb] transition-colors"
                                >Software Development</span
                            >
                            <!-- ArrowRight icon -->
                            <svg
                                class="w-4 h-4 text-gray-600 group-hover:text-[#2563eb] group-hover:translate-x-1 transition-all"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="M12 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    </a>

                    <a
                        href="/services/mobile-development"
                        class="text-left p-4 rounded-lg bg-[#0a0a0f]/50 hover:bg-[#0a0a0f] transition-colors group"
                    >
                        <div class="flex items-center justify-between">
                            <span
                                class="text-gray-300 group-hover:text-[#2563eb] transition-colors"
                                >Mobile Development</span
                            >
                            <svg
                                class="w-4 h-4 text-gray-600 group-hover:text-[#2563eb] group-hover:translate-x-1 transition-all"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="M12 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    </a>

                    <a
                        href="/about"
                        class="text-left p-4 rounded-lg bg-[#0a0a0f]/50 hover:bg-[#0a0a0f] transition-colors group"
                    >
                        <div class="flex items-center justify-between">
                            <span
                                class="text-gray-300 group-hover:text-[#2563eb] transition-colors"
                                >About Us</span
                            >
                            <svg
                                class="w-4 h-4 text-gray-600 group-hover:text-[#2563eb] group-hover:translate-x-1 transition-all"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="M12 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    </a>

                    <a
                        href="/contact"
                        class="text-left p-4 rounded-lg bg-[#0a0a0f]/50 hover:bg-[#0a0a0f] transition-colors group"
                    >
                        <div class="flex items-center justify-between">
                            <span
                                class="text-gray-300 group-hover:text-[#2563eb] transition-colors"
                                >Contact Us</span
                            >
                            <svg
                                class="w-4 h-4 text-gray-600 group-hover:text-[#2563eb] group-hover:translate-x-1 transition-all"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="M12 5l7 7-7 7"></path>
                            </svg>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </main>
</BaseLayout>
