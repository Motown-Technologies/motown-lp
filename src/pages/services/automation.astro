---
import Card from "../../components/Card.astro";
import CardIcon from "../../components/CardIcon.astro";
import CardTitle from "../../components/CardTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Image } from "astro:assets";

import processImage from "../../img/business-automation-dashboard-with-analytics-and-w.jpg";
import bannerImage from "../../img/robotic-process-automation-with-digital-workflows-.jpg";
---

<BaseLayout>
    <main class="min-h-screen bg-[#0a0a0f]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] to-[#1a1a2e] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-block mb-4">
                            <span
                                class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                                >Automation</span
                            >
                        </div>
                        <h1
                            class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight text-balance"
                        >
                            Work smarter, not harder
                        </h1>
                        <p
                            class="text-xl text-gray-400 leading-relaxed mb-8 text-pretty"
                        >
                            Transform your business operations with intelligent
                            automation solutions. We help you eliminate
                            repetitive tasks, reduce errors, and free your team
                            to focus on what matters most.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a
                                href="/contact"
                                class="px-8 py-4 bg-white text-[#0a0a0f] font-semibold rounded-lg hover:bg-gray-100 transition-colors"
                            >
                                Automate Your Workflow
                            </a>
                            <a
                                href="#solutions"
                                class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
                            >
                                View Solutions
                            </a>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                        >
                            <Image
                                src={bannerImage}
                                alt="Automation Solutions"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Solutions Section -->
        <section id="solutions" class="py-24 bg-[#0a0a0f]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                        Automation Solutions
                    </h2>
                    <p
                        class="text-xl text-gray-400 max-w-3xl mx-auto text-pretty"
                    >
                        From simple task automation to complex workflow
                        orchestration, we deliver solutions that drive
                        efficiency
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- Business Process Automation -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
