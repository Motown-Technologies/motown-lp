                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                    ><path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path></svg
                                >
                                <span class="text-slate-700"
                                    >Influencer partnerships</span
                                >
                            </li>
                        </ul>
                    </Card>

                    <!-- Content Marketing -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle>
                            Content Marketing
                        </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Create compelling content that attracts, engages,
                            and converts your audience
