                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                    ><path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path></svg
                                ><span class="text-slate-700"
                                    >Infographics &amp; visual content</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                    ><path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path></svg
                                ><span class="text-slate-700"
                                    >E-books &amp; whitepapers</span
                                >
                            </li>
                        </ul>
                    </Card>

                    <!-- Email Marketing -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle>
                            Email Marketing
                        </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Nurture leads and drive conversions with targeted
                            email campaigns
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
