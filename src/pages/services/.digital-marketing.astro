                    <!-- PPC Advertising -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle>
                            PPC Advertising
                        </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Maximize ROI with strategic pay-per-click
                            advertising campaigns
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                    ><path
                                        d="M20 6 9 17l-5-5"
