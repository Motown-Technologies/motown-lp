                            <Image
                                src={processImage}
                                alt="Digital Marketing Results"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>

                    <div>
                        <h2
                            class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"
                        >
                            Proven Results That Matter
