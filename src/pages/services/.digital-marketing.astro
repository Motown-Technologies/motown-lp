---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Card from "../../components/Card.astro";
import CardIcon from "../../components/CardIcon.astro";
import CardTitle from "../../components/CardTitle.astro";

import { Image } from "astro:assets";

import bannerImage from "../../img/digital-marketing-analytics-dashboard-with-graphs-.jpg";
import processImage from "../../img/digital-marketing-team-analyzing-data-and-metrics-.jpg";
---

<BaseLayout>
    <main class="min-h-screen bg-[#f7f8fc]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] to-[#eef2ff] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-block mb-4">
                            <span
                                class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                                >Digital Marketing</span
                            >
                        </div>
                        <h1
                            class="text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight text-balance"
                        >
                            Grow Your Brand Online
                        </h1>
                        <p
                            class="text-xl text-slate-600 leading-relaxed mb-8 text-pretty"
                        >
                            Drive measurable results with data-driven digital
                            marketing strategies. We help you reach your target
                            audience, increase engagement, and convert visitors
                            into loyal customers.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a
                                href="#contact"
                                class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors"
                            >
                                Start Growing Today
                            </a>
                            <a
                                href="#services"
                                class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                            >
                                View Services
                            </a>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                        >
                            <Image
                                src={bannerImage}
                                alt="Digital Marketing Solutions"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="py-24 bg-[#f7f8fc]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
                        Digital Marketing Services
                    </h2>
                    <p
                        class="text-xl text-slate-600 max-w-3xl mx-auto text-pretty"
                    >
                        Comprehensive digital marketing solutions to elevate
                        your brand and drive growth
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- SEO & SEM -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle>
                            SEO &amp; SEM
                        </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Dominate search results and drive qualified traffic
                            to your website
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <!-- Check icon -->
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Keyword research &amp; strategy</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >On-page &amp; technical SEO</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Google Ads campaigns</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        d="M20 6 9 17l-5-5"
                                        stroke-width="2"
                                        stroke-linecap="round"
                                        stroke-linejoin="round"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Local SEO optimization</span
                                >
                            </li>
                        </ul>
                    </Card>

                    <!-- Social Media Marketing -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                                aria-hidden="true"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a2 2 0 01-2-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle>
                            Social Media Marketing
