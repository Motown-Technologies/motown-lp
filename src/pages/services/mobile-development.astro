---
import Card from "../../components/Card.astro";
import CardIcon from "../../components/CardIcon.astro";
import CardTitle from "../../components/CardTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import processImg from "../../img/mobile-app-development-team-working-on-app-design-.jpg";
import heroImg from "../../img/mobile-app-development-with-smartphones-showing-mo.jpg";
---

<BaseLayout>
    <main class="min-h-screen bg-[#f7f8fc]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] to-[#eef2ff] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-block mb-4">
                            <span
                                class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                            >
                                Mobile App Development
                            </span>
                        </div>
                        <h1
                            class="text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight text-balance"
                        >
                            Apps that users love
                        </h1>
                        <p
                            class="text-xl text-slate-600 leading-relaxed mb-8 text-pretty"
                        >
                            Create powerful mobile experiences for iOS and
                            Android. We build cross-platform apps that engage
                            users and drive business growth.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a
                                href="/contact"
                                class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors"
                            >
                                Start Your App
                            </a>
                            <a
                                href="#capabilities"
                                class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                            >
                                View Capabilities
                            </a>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                        >
                            <Image
                                src={heroImg}
                                alt="Mobile App Development"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Capabilities Section -->
        <section id="capabilities" class="py-24 bg-[#f7f8fc]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
                        What We Build
                    </h2>
                    <p
                        class="text-xl text-slate-600 max-w-3xl mx-auto text-pretty"
                    >
                        From consumer apps to enterprise solutions, we create
                        mobile experiences that users love
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- iOS Development -->
