                                        <span class="text-slate-700">{t}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </Card> -->

                    <!-- Backend Integration -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> Backend Integration </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Robust backend systems that power your mobile app
                        </p>
                        <ul class="space-y-3">
                            {
                                [
                                    "RESTful & GraphQL APIs",
                                    "Real-time data sync",
                                    "Push notifications",
                                    "Cloud storage integration",
                                ].map((t) => (
                                    <li class="flex items-start gap-3">
                                        <svg
                                            class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 13l4 4L19 7"
                                            />
                                        </svg>
                                        <span class="text-slate-700">{t}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </Card>

                    <!-- App Maintenance -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                                ></path>
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> App Maintenance </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Ongoing support to keep your app running smoothly
                        </p>
                        <ul class="space-y-3">
                            {
                                [
                                    "Bug fixes & updates",
                                    "OS compatibility updates",
                                    "Performance monitoring",
                                    "Feature enhancements",
                                ].map((t) => (
                                    <li class="flex items-start gap-3">
                                        <svg
                                            class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 13l4 4L19 7"
                                            />
                                        </svg>
                                        <span class="text-slate-700">{t}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </Card>
                </div>
            </div>
        </section>

        <!-- Process Section -->
        <section class="py-24 section-dark">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="relative">
                        <div
                            class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                        >
                            <Image
                                src={processImg}
                                alt="Development Process"
                                class="w-full h-full object-cover opacity-80"
                                loading="lazy"
                            />
                        </div>
                    </div>

                    <div>
                        <h2
                            class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"
                        >
                            Our Development Process
                        </h2>
                        <p
                            class="text-xl text-slate-600 mb-8 leading-relaxed text-pretty"
                        >
                            We follow agile methodologies to deliver
                            high-quality mobile apps that exceed expectations.
                        </p>

                        <div class="space-y-6">
                            {
                                [
                                    {
                                        n: 1,
                                        h: "Strategy & Planning",
                                        d: "We define your app's goals, features, and technical requirements",
                                    },
                                    {
                                        n: 2,
                                        h: "Design & Prototype",
                                        d: "Our designers create intuitive interfaces and interactive prototypes",
                                    },
                                    {
                                        n: 3,
                                        h: "Development & Testing",
                                        d: "We build your app with rigorous testing on real devices",
                                    },
                                    {
                                        n: 4,
                                        h: "Launch & Support",
                                        d: "We handle app store submission and provide ongoing support",
                                    },
                                ].map((s) => (
                                    <div class="flex gap-4">
                                        <div class="flex-shrink-0 w-12 h-12 bg-[#2563eb] rounded-lg flex items-center justify-center text-white font-bold text-xl">
                                            {s.n}
                                        </div>
                                        <div>
                                            <h3 class="text-xl font-bold text-slate-900 mb-2">
                                                {s.h}
                                            </h3>
                                            <p class="text-slate-600 leading-relaxed">
                                                {s.d}
                                            </p>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 bg-gradient-to-b from-[#eef2ff] to-[#f8fafc]">
            <div class="max-w-4xl mx-auto px-6 text-center">
                <h2
                    class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 text-balance"
                >
                    Ready to Build Your Mobile App?
                </h2>
                <p
                    class="text-xl text-slate-600 mb-10 leading-relaxed text-pretty"
                >
                    Let's create a mobile experience that your users will love.
                    Get in touch to discuss your project.
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="/contact"
                        class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors"
                    >
                        Get Started
                    </a>
                    <a
                        href="/services"
                        class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                    >
                        View All Services
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
