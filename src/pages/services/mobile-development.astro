                    <!-- Cross-Platform -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> Cross-Platform </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Build once, deploy everywhere with React Native and
                            Flutter
                        </p>
                        <ul class="space-y-3">
                            {
                                [
                                    "React Native & Flutter",
                                    "Shared codebase",
                                    "Native performance",
                                    "Faster time to market",
                                ].map((t) => (
                                    <li class="flex items-start gap-3">
                                        <svg
                                            class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 13l4 4L19 7"
                                            />
                                        </svg>
                                        <span class="text-slate-700">{t}</span>
                                    </li>
                                ))
                            }
                        </ul>
                    </Card>

                    <!-- Mobile UI/UX -->
                    <!-- <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> Mobile UI/UX </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Intuitive interfaces designed for mobile-first
                            experiences
                        </p>
                        <ul class="space-y-3">
                            {
                                [
                                    "User research & testing",
                                    "Wireframing & prototyping",
                                    "Gesture-based interactions",
                                    "Accessibility standards",
                                ].map((t) => (
                                    <li class="flex items-start gap-3">
                                        <svg
                                            class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                stroke-width="2"
                                                d="M5 13l4 4L19 7"
