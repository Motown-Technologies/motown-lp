---
import Card from "../../components/Card.astro";
import CardIcon from "../../components/CardIcon.astro";
import CardTitle from "../../components/CardTitle.astro";
import services, { type Service } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Icons
import AutomationIcon from "../../components/icons/AutomationIcon.astro";
import CheckIcon from "../../components/icons/CheckIcon.astro";
import ConsultingIcon from "../../components/icons/ConsultingIcon.astro";
import MarketingIcon from "../../components/icons/MarketingIcon.astro";
import MobileIcon from "../../components/icons/MobileIcon.astro";
import SoftwareIcon from "../../components/icons/SoftwareIcon.astro";
import WebIcon from "../../components/icons/WebIcon.astro";

const ICONS: Record<string, any> = {
    software: SoftwareIcon,
    marketing: MarketingIcon,
    mobile: MobileIcon,
    automation: AutomationIcon,
    consulting: ConsultingIcon,
    web: WebIcon,
};
---

<BaseLayout meta_title="Services | Motown Tech" meta_description="Explore Motown Tech services including software development, web design, mobile apps, automation, and consulting.">
    <!-- Hero Section -->
    <section
        class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] to-[#eef2ff] pt-8 pb-24"
    >
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center max-w-4xl mx-auto">
                <div class="inline-block mb-4">
                    <span
                        class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                        >Our Services</span
                    >
                </div>
                <h1
                    class="text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight text-balance"
                >
                    Comprehensive Solutions for Your Business
                </h1>
                <p class="text-xl text-slate-600 leading-relaxed text-pretty">
                    From software development to automation, we provide
                    end-to-end technology solutions that drive growth and
                    innovation
                </p>
            </div>
        </div>
    </section>

    <!-- Services Grid -->
    <section class="py-24 bg-[#f7f8fc]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-12">
                {
                    services.map((svc: Service, idx: number) => {
                        const Icon = ICONS[svc.icon] ?? SoftwareIcon;

                        const toSlug = (s: string) =>
                            s
                                .toLowerCase()
                                .replace(/[^a-z0-9]+/g, "-")
                                .replace(/(^-|-$)/g, "");

                        const href = svc.href ?? "/" + toSlug(svc.title);

                        const spanClass =
                            idx < 2 ? "lg:col-span-6" : "lg:col-span-4";

                        return (
                            <Card
                                href={href}
                                class={spanClass}
                                aria-label={`${svc.title} – Learn more`}
                            >
                                <CardIcon>
                                    <Icon class="w-6 h-6 text-[#2563eb]" />
                                </CardIcon>

                                <CardTitle>{svc.title}</CardTitle>

                                <p class="text-slate-600 mb-6 leading-relaxed">
                                    {svc.description}
                                </p>

                                <ul class="space-y-3 mb-6">
                                    {svc.bullets.map((b: string) => (
                                        <li class="flex items-start gap-3">
                                            <CheckIcon />
                                            <span class="text-slate-700">
                                                {b}
                                            </span>
                                        </li>
                                    ))}
                                </ul>

                                <span class="inline-flex items-center text-[#2563eb] group-hover:text-[#1d4ed8] font-semibold transition-colors">
                                    Learn More
                                    <svg
                                        class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="2"
                                        aria-hidden="true"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M5 12h14"
                                        />
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="m12 5 7 7-7 7"
                                        />
                                    </svg>
                                </span>
                            </Card>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 section-dark">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2
                class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 text-balance"
            >
                Ready to Transform Your Business?
            </h2>
            <p class="text-xl text-slate-600 mb-10 leading-relaxed text-pretty">
                Let's discuss how our services can help you achieve your goals.
                Get in touch with our team today.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href="/contact"
                    class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors"
                >
                    Get Started
                </a>
                <a
                    href="/"
                    class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                >
                    Back to Home
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
