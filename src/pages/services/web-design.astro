---
import { Image } from "astro:assets";
import bannerImage from "../../img/modern-web-design-workspace-with-multiple-screens-.jpg";
import processImage from "../../img/web-design-process-with-wireframes-and-mockups-on-.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout>
    <main class="min-h-screen bg-[#0a0a0f]">
        {/* Hero Section */}
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] to-[#1a1a2e] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-block mb-4">
                            <span
                                class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                            >
                                Web Design &amp; Development
                            </span>
                        </div>
                        <h1
                            class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight text-balance"
                        >
                            Beautiful websites that convert
                        </h1>
                        <p
                            class="text-xl text-gray-400 leading-relaxed mb-8 text-pretty"
                        >
                            We create stunning, user-friendly websites that
                            captivate your audience and drive business growth.
                            From concept to launch, we deliver digital
                            experiences that make an impact.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a
                                href="/contact"
                                class="px-8 py-4 bg-white text-[#0a0a0f] font-semibold rounded-lg hover:bg-gray-100 transition-colors"
                            >
                                Start Your Project
                            </a>
                            <a
                                href="#services"
                                class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
                            >
                                View Services
                            </a>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                        >
                            <Image
                                src={bannerImage}
                                alt="Web Design"
                                class="w-full h-full object-cover opacity-80"
                                loading="eager"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {/* Services Section */}
        <section id="services" class="py-24 bg-[#0a0a0f]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                        What We Design
                    </h2>
                    <p
                        class="text-xl text-gray-400 max-w-3xl mx-auto text-pretty"
                    >
                        From landing pages to complex web applications, we craft
                        digital experiences that engage and convert
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {/* Responsive Web Design */}
                    <div
                        class="group h-full rounded-2xl border border-gray-800 bg-[#1a1a2e] p-8 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/60 hover:shadow-[0_25px_50px_rgba(37,99,235,0.2)]"
                    >
                        <div
                            class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 transition-colors group-hover:bg-[#2563eb]/30"
                        >
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                ></path>
                            </svg>
                        </div>
                        <h3 class="text-2xl font-bold text-white mb-4 transition-colors group-hover:text-[#2563eb]">
                            Responsive Design
                        </h3>
                        <p class="text-gray-400 mb-6 leading-relaxed">
                            Websites that look perfect on every device, from
                            mobile to desktop
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-gray-300"
                                    >Mobile-first approach</span
