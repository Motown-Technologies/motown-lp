---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Image } from "astro:assets";

import processImage from "../../img/it-consultant-presenting-technology-strategy-to-bu.jpg";
import bannerImage from "../../img/it-consulting-meeting-with-business-professionals-.jpg";
---

<BaseLayout>
    <main class="min-h-screen bg-[#0a0a0f]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] to-[#1a1a2e] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-block mb-4">
                            <span
                                class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                                >IT Consulting</span
                            >
                        </div>
                        <h1
                            class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight text-balance"
                        >
                            Strategic IT guidance for growth
                        </h1>
                        <p
                            class="text-xl text-gray-400 leading-relaxed mb-8 text-pretty"
                        >
                            Navigate complex technology decisions with
                            confidence. Our expert consultants help you align IT
                            strategy with business goals to drive innovation and
                            efficiency.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a
                                href="/contact"
                                class="px-8 py-4 bg-white text-[#0a0a0f] font-semibold rounded-lg hover:bg-gray-100 transition-colors"
                            >
                                Schedule Consultation
                            </a>
                            <a
                                href="#services"
                                class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
                            >
                                View Services
                            </a>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                        >
                            <Image
                                src={bannerImage}
                                alt="IT Consulting"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="py-24 bg-[#0a0a0f]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                        Consulting Services
                    </h2>
                    <p
                        class="text-xl text-gray-400 max-w-3xl mx-auto text-pretty"
                    >
                        Expert guidance across all aspects of IT strategy and
                        implementation
                    </p>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                    <!-- IT Strategy -->
