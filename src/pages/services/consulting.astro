                        <div
                            class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 transition-colors group-hover:bg-[#2563eb]/30"
                        >
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
