---
import Card from "../../components/Card.astro";
import CardIcon from "../../components/CardIcon.astro";
import CardTitle from "../../components/CardTitle.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Image } from "astro:assets";

import processImage from "../../img/it-consultant-presenting-technology-strategy-to-bu.jpg";
import bannerImage from "../../img/it-consulting-meeting-with-business-professionals-.jpg";
---

<BaseLayout>
    <main class="min-h-screen bg-[#f7f8fc]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] to-[#eef2ff] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-12 items-center">
                    <div>
                        <div class="inline-block mb-4">
                            <span
                                class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                                >IT Consulting</span
                            >
                        </div>
                        <h1
                            class="text-5xl md:text-6xl lg:text-7xl font-bold text-slate-900 mb-6 leading-tight text-balance"
                        >
                            Strategic IT guidance for growth
                        </h1>
                        <p
                            class="text-xl text-slate-600 leading-relaxed mb-8 text-pretty"
                        >
                            Navigate complex technology decisions with
                            confidence. Our expert consultants help you align IT
                            strategy with business goals to drive innovation and
                            efficiency.
                        </p>
                        <div class="flex flex-wrap gap-4">
                            <a
                                href="/contact"
                                class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors"
                            >
                                Schedule Consultation
                            </a>
                            <a
                                href="#services"
                                class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                            >
                                View Services
                            </a>
                        </div>
                    </div>

                    <div class="relative">
                        <div
                            class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                        >
                            <Image
                                src={bannerImage}
                                alt="IT Consulting"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Services Section -->
        <section id="services" class="py-24 bg-[#f7f8fc]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
                        Consulting Services
                    </h2>
                    <p
                        class="text-xl text-slate-600 max-w-3xl mx-auto text-pretty"
                    >
                        Expert guidance across all aspects of IT strategy and
                        implementation
                    </p>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    <!-- IT Strategy -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> IT Strategy </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Develop comprehensive IT roadmaps aligned with
                            business objectives
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <!-- check -->
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Technology assessment</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Strategic planning</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Digital transformation</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700">ROI analysis</span>
                            </li>
                        </ul>
                    </Card>

                    <!-- Software Selection -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> Software Selection </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Choose the right software solutions for your
                            business needs
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Requirements analysis</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Vendor evaluation</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Cost-benefit analysis</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Implementation planning</span
                                >
                            </li>
                        </ul>
                    </Card>

                    <!-- Process Optimization -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> Process Optimization </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Streamline operations with technology-driven
                            efficiency improvements
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Workflow analysis</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Automation opportunities</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Best practices implementation</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Change management</span
                                >
                            </li>
                        </ul>
                    </Card>

                    <!-- Technology Training -->
                    <Card>
                        <CardIcon>
                            <svg
                                class="w-6 h-6 text-[#2563eb]"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke="currentColor"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                                ></path>
                            </svg>
                        </CardIcon>
                        <CardTitle> Platform Modernization Advisory </CardTitle>
                        <p class="text-slate-600 mb-6 leading-relaxed">
                            Evaluate legacy stacks, plan migrations, and
                            optimize cloud investments
                        </p>
                        <ul class="space-y-3">
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Current-state architecture reviews</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Workshops & seminars</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Documentation & guides</span
                                >
                            </li>
                            <li class="flex items-start gap-3">
                                <svg
                                    class="w-5 h-5 text-[#2563eb] flex-shrink-0 mt-0.5"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                                <span class="text-slate-700"
                                    >Ongoing support</span
                                >
                            </li>
                        </ul>
                    </Card>
                </div>
            </div>
        </section>

        <!-- Approach Section -->
        <section class="py-24 section-dark">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16 items-center">
                    <div class="relative">
                        <div
                            class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                        >
                            <Image
                                src={processImage}
                                alt="Consulting Approach"
                                class="w-full h-full object-cover opacity-80"
                            />
                        </div>
                    </div>

                    <div>
                        <h2
                            class="text-4xl md:text-5xl font-bold text-slate-900 mb-6"
                        >
                            Our Consulting Approach
                        </h2>
                        <p
                            class="text-xl text-slate-600 mb-8 leading-relaxed text-pretty"
                        >
                            We partner with you to understand your unique
                            challenges and deliver actionable solutions that
                            drive real business value.
                        </p>

                        <div class="space-y-6">
                            <div class="flex gap-4">
                                <div
                                    class="flex-shrink-0 w-12 h-12 bg-[#2563eb] rounded-lg flex items-center justify-center text-white font-bold text-xl"
                                >
                                    1
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-slate-900 mb-2"
                                    >
                                        Discovery & Assessment
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed">
                                        We analyze your current IT landscape,
                                        business goals, and pain points
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div
                                    class="flex-shrink-0 w-12 h-12 bg-[#2563eb] rounded-lg flex items-center justify-center text-white font-bold text-xl"
                                >
                                    2
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-slate-900 mb-2"
                                    >
                                        Strategy Development
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed">
                                        We create a comprehensive roadmap with
                                        clear priorities and timelines
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div
                                    class="flex-shrink-0 w-12 h-12 bg-[#2563eb] rounded-lg flex items-center justify-center text-white font-bold text-xl"
                                >
                                    3
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-slate-900 mb-2"
                                    >
                                        Implementation Support
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed">
                                        We guide you through execution with
                                        hands-on support and expertise
                                    </p>
                                </div>
                            </div>

                            <div class="flex gap-4">
                                <div
                                    class="flex-shrink-0 w-12 h-12 bg-[#2563eb] rounded-lg flex items-center justify-center text-white font-bold text-xl"
                                >
                                    4
                                </div>
                                <div>
                                    <h3
                                        class="text-xl font-bold text-slate-900 mb-2"
                                    >
                                        Continuous Improvement
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed">
                                        We monitor results and optimize
                                        strategies for ongoing success
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 bg-gradient-to-b from-[#eef2ff] to-[#f8fafc]">
            <div class="max-w-4xl mx-auto px-6 text-center">
                <h2
                    class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 text-balance"
                >
                    Ready to Transform Your IT Strategy?
                </h2>
                <p
                    class="text-xl text-slate-600 mb-10 leading-relaxed text-pretty"
                >
                    Schedule a consultation with our experts to discuss your
                    technology challenges and opportunities.
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a
                        href="/contact"
                        class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors"
                    >
                        Schedule Consultation
                    </a>
                    <a
                        href="/services"
                        class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                    >
                        View All Services
                    </a>
                </div>
            </div>
        </section>
    </main>
</BaseLayout>
