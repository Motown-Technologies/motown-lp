---
import BaseLayout from "../layouts/BaseLayout.astro";

import MailIcon from "../components/icons/MailIcon.astro";
import PhoneIcon from "../components/icons/PhoneIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
---

<BaseLayout>
    <main class="min-h-screen bg-[#0a0a0f]">
        <!-- Hero Section -->
        <section
            class="relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] to-[#1a1a2e] pt-8 pb-24"
        >
            <div class="max-w-7xl mx-auto px-6">
                <div class="max-w-3xl">
                    <div class="inline-block mb-4">
                        <span
                            class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                            >Get In Touch</span
                            data-success-message="Thanks! We'll get back to you shortly."
                            data-error-message="Something went wrong. Please try again."
                        >
                    </div>
                    <h1
                        class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight text-balance"
                    >
                        Let's start building together
                    </h1>
                    <p
                        class="text-xl text-gray-400 leading-relaxed text-pretty"
                    >
                        Have a project in mind? We'd love to hear about it.
                        Reach out and let's discuss how we can help bring your
                        vision to life.
                    </p>
                </div>
            </div>
        </section>

        <!-- Contact Form & Info Section -->
        <section class="py-24 bg-[#0a0a0f]">
            <div class="max-w-7xl mx-auto px-6">
                <div class="grid lg:grid-cols-2 gap-16">
                    <!-- Contact Form -->
                    <div>
                        <h2 class="text-3xl font-bold text-white mb-8">
                            Send us a message
                        </h2>
                        <form
                            class="space-y-6"
                            action="https://api.web3forms.com/submit"
                            method="POST"
                            data-contact-form
                            novalidate
                        >
                            <input
                                type="hidden"
                                name="access_key"
                                value="9333b567-0c0f-46d0-a446-f4b9795d1885"
                            />
                            <div class="grid md:grid-cols-2 gap-6">
                                <div>
                                    <label
                                        for="firstName"
                                        class="block text-sm font-medium text-gray-300 mb-2"
                                        >First Name</label
                                    >
                                    <input
                                        type="text"
                                        id="firstName"
                                        name="firstName"
                                        class="w-full px-4 py-3 bg-[#1a1a2e] border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#2563eb] transition-colors"
                                        placeholder="John"
                                        required
                                    />
                                </div>
                                <div>
                                    <label
                                        for="lastName"
                                        class="block text-sm font-medium text-gray-300 mb-2"
                                        >Last Name</label
                                    >
                                    <input
                                        type="text"
                                        id="lastName"
                                        name="lastName"
                                        class="w-full px-4 py-3 bg-[#1a1a2e] border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#2563eb] transition-colors"
                                        placeholder="Doe"
                                        required
                                    />
                                </div>
                            </div>

                            <div>
                                <label
                                    for="email"
                                    class="block text-sm font-medium text-gray-300 mb-2"
                                    >Email Address</label
                                >
                                <input
                                    type="email"
                                    id="email"
                                    name="email"
                                    class="w-full px-4 py-3 bg-[#1a1a2e] border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#2563eb] transition-colors"
                                    placeholder="john@example.com"
                                    required
                                />
                            </div>

                            <div>
                                <label
                                    for="phone"
                                    class="block text-sm font-medium text-gray-300 mb-2"
                                    >Phone Number</label
                                >
                                <input
                                    type="tel"
                                    id="phone"
                                    name="phone"
                                    class="w-full px-4 py-3 bg-[#1a1a2e] border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#2563eb] transition-colors"
                                    placeholder="(555) 123-4567"
                                />
                            </div>

                            <!-- <div>
                                <label
                                    for="service"
                                    class="block text-sm font-medium text-gray-300 mb-2"
                                    >Service Interested In</label
                                >
                                <select
                                    id="service"
                                    name="service"
                                    class="w-full px-4 py-3 bg-[#1a1a2e] border border-gray-700 rounded-lg text-white focus:outline-none focus:border-[#2563eb] transition-colors"
                                    required
                                >
                                    <option value="">Select a service</option>
                                    <option value="software-development"
                                        >Software Development</option
                                    >
                                    <option value="web-design"
                                        >Web Design</option
                                    >
                                    <option value="mobile-apps"
                                        >Mobile Apps</option
                                    >
                                    <option value="consulting"
                                        >Consulting</option
                                    >
                                    <option value="other">Other</option>
                                </select>
                            </div> -->

                            <div>
                                <label
                                    for="message"
                                    class="block text-sm font-medium text-gray-300 mb-2"
                                    >Project Details</label
                                >
                                <textarea
                                    id="message"
                                    name="message"
                                    rows="6"
                                    class="w-full px-4 py-3 bg-[#1a1a2e] border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-[#2563eb] transition-colors resize-none"
                                    placeholder="Tell us about your project..."
                                    required></textarea>
                            </div>

                            <div
                                class="h-captcha"
                                data-captcha="true"
                                data-lang="en"
                                data-theme="dark"
                            >
                            </div>

                            <p
                                class="hidden rounded-lg border border-[#22c55e]/40 bg-[#22c55e]/10 px-4 py-3 text-sm font-semibold text-[#86efac]"
                                data-form-success
                                role="status"
                            ></p>
                            <p
                                class="hidden rounded-lg border border-[#f87171]/40 bg-[#f87171]/10 px-4 py-3 text-sm font-semibold text-[#fca5a5]"
                                data-form-error
                                role="alert"
                            ></p>

                            <button
                                type="submit"
                                class="w-full px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
                                data-submit-button
                            >
                                <span
                                    class="hidden h-5 w-5 border-2 border-white/30 border-t-white rounded-full animate-spin"
                                    aria-hidden="true"
                                    data-submit-loader
                                ></span>
                                <SendIcon class="w-5 h-5" data-submit-icon />
                                <span data-submit-label>Send Message</span>
                            </button>
                        </form>
                    </div>

                    <!-- Contact Information -->
                    <div class="space-y-8">
                        <div>
                            <h2 class="text-3xl font-bold text-white mb-8">
                                Contact Information
                            </h2>
                            <p class="text-gray-400 leading-relaxed mb-8">
                                We're here to answer your questions and discuss
                                your next project. Reach out through any of
                                these channels.
                            </p>
                        </div>

                        <div class="space-y-6">
                            <div
                                class="bg-[#1a1a2e] rounded-xl p-6 border border-gray-800"
                            >
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center flex-shrink-0"
                                    >
                                        <MailIcon />
                                    </div>
                                    <div>
                                        <h3
                                            class="text-lg font-semibold text-white mb-2"
                                        >
                                            Email Us
                                        </h3>
                                        <a
                                            href="mailto:contact@motowntech.com"
                                            class="text-gray-400 hover:text-[#2563eb] transition-colors"
                                        >
                                            contact@motowntech.com
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div
                                class="bg-[#1a1a2e] rounded-xl p-6 border border-gray-800"
                            >
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center flex-shrink-0"
                                    >
                                        <PhoneIcon />
                                    </div>
                                    <div>
                                        <h3
                                            class="text-lg font-semibold text-white mb-2"
                                        >
                                            Call Us
                                        </h3>
                                        <a
                                            href="tel:+15551234567"
                                            class="text-gray-400 hover:text-[#2563eb] transition-colors"
                                        >
                                            (555) 123-4567
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- <div
                                class="bg-[#1a1a2e] rounded-xl p-6 border border-gray-800"
                            >
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center flex-shrink-0"
                                    >
                                        <MapPinIcon />
                                    </div>
                                    <div>
                                        <h3
                                            class="text-lg font-semibold text-white mb-2"
                                        >
                                            Visit Us
                                        </h3>
                                        <p class="text-gray-400">
                                            123 Tech Street<br />Detroit, MI
                                            48201
                                        </p>
                                    </div>
                                </div>
                            </div> -->

                            <!-- <div
                                class="bg-[#1a1a2e] rounded-xl p-6 border border-gray-800"
                            >
                                <div class="flex items-start gap-4">
                                    <div
                                        class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center flex-shrink-0"
                                    >
                                        <ClockIcon />
                                    </div>
                                    <div>
                                        <h3
                                            class="text-lg font-semibold text-white mb-2"
                                        >
                                            Business Hours
                                        </h3>
                                        <div class="text-gray-400 space-y-1">
                                            <p>
                                                Monday - Friday: 9:00 AM - 6:00
                                                PM
                                            </p>
                                            <p>Saturday: 10:00 AM - 4:00 PM</p>
                                            <p>Sunday: Closed</p>
                                        </div>
                                    </div>
                                </div>
                            </div> -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="py-24 bg-[#1a1a2e]">
            <div class="max-w-4xl mx-auto px-6">
                <div class="text-center mb-16">
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                        Frequently Asked Questions
                    </h2>
                    <p class="text-xl text-gray-400 text-pretty">
                        Quick answers to common questions about working with us
                    </p>
                </div>

                <div class="space-y-6">
                    <div
                        class="bg-[#0a0a0f] rounded-xl p-6 border border-gray-800"
                    >
                        <h3 class="text-xl font-semibold text-white mb-3">
                            How long does a typical project take?
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            Project timelines vary based on scope and
                            complexity. A simple website might take 2–4 weeks,
                            while a complex web application could take 3–6
                            months. We'll provide a detailed timeline during our
                            initial consultation.
                        </p>
                    </div>

                    <div
                        class="bg-[#0a0a0f] rounded-xl p-6 border border-gray-800"
                    >
                        <h3 class="text-xl font-semibold text-white mb-3">
                            What is your development process?
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            We follow an agile methodology with regular
                            check-ins and iterations. This includes discovery,
                            design, development, testing, and deployment phases
                            with continuous client collaboration throughout.
                        </p>
                    </div>

                    <div
                        class="bg-[#0a0a0f] rounded-xl p-6 border border-gray-800"
                    >
                        <h3 class="text-xl font-semibold text-white mb-3">
                            Do you provide ongoing support?
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            Yes! We offer maintenance and support packages to
                            keep your application running smoothly. This
                            includes bug fixes, updates, security patches, and
                            feature enhancements as needed.
                        </p>
                    </div>

                    <div
                        class="bg-[#0a0a0f] rounded-xl p-6 border border-gray-800"
                    >
                        <h3 class="text-xl font-semibold text-white mb-3">
                            What technologies do you work with?
                        </h3>
                        <p class="text-gray-400 leading-relaxed">
                            We specialize in modern web technologies including
                            React, Next.js, Node.js, Python, and cloud platforms
                            like AWS and Azure. We choose the best tech stack
                            for your specific needs and goals.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA Section -->
        <section class="py-24 bg-gradient-to-b from-[#0a0a0f] to-[#1a1a2e]">
            <div class="max-w-4xl mx-auto px-6 text-center">
                <h2
                    class="text-4xl md:text-5xl font-bold text-white mb-6 text-balance"
                >
                    Ready to Start Your Project?
                </h2>
                <p
                    class="text-xl text-gray-400 mb-10 leading-relaxed text-pretty"
                >
                    Fill out the form above or reach out directly. We typically
                    respond within 24 hours.
                </p>
                <a
                    href="/services"
                    class="inline-block px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
                >
                    View Our Services
                </a>
            </div>
        </section>
    </main>
</BaseLayout>

<script type="module">
    const form = document.querySelector("[data-contact-form]");
    const submitButton = form?.querySelector("[data-submit-button]");
    const loader = form?.querySelector("[data-submit-loader]");
    const submitIcon = form?.querySelector("[data-submit-icon]");
    const submitLabel = form?.querySelector("[data-submit-label]");
    const successMessage = form?.querySelector("[data-form-success]");
    const errorMessage = form?.querySelector("[data-form-error]");
    const successText = form?.dataset.successMessage ?? "Message sent!";
    const errorText = form?.dataset.errorMessage ?? "Please try again.";

    const setSubmittingState = (isSubmitting) => {
        if (!submitButton) return;
        if (isSubmitting) {
            submitButton.setAttribute("disabled", "true");
            loader?.classList.remove("hidden");
            submitIcon?.classList.add("hidden");
            if (submitLabel) submitLabel.textContent = "Sending...";
        } else {
            submitButton.removeAttribute("disabled");
            loader?.classList.add("hidden");
            submitIcon?.classList.remove("hidden");
            if (submitLabel) submitLabel.textContent = "Send Message";
        }
    };

    const clearMessages = () => {
        successMessage?.classList.add("hidden");
        errorMessage?.classList.add("hidden");
    };

    const showMessage = (type, text) => {
        if (!text) return;
        if (type === "success") {
            if (successMessage) {
                successMessage.textContent = text;
                successMessage.classList.remove("hidden");
            }
            errorMessage?.classList.add("hidden");
        } else {
            if (errorMessage) {
                errorMessage.textContent = text;
                errorMessage.classList.remove("hidden");
            }
            successMessage?.classList.add("hidden");
        }
    };

    form?.addEventListener("submit", async (event) => {
        if (!form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
            return;
        }

        event.preventDefault();
        clearMessages();
        setSubmittingState(true);

        try {
            const formData = new FormData(form);
            const response = await fetch("https://api.web3forms.com/submit", {
                method: "POST",
                body: formData,
            });

            const result = await response.json();

            if (response.ok && result.success) {
                form.reset();
                showMessage("success", successText);
            } else {
                showMessage("error", result.message ?? errorText);
            }
        } catch (error) {
            showMessage("error", errorText);
        } finally {
            setSubmittingState(false);
        }
    });
</script>

<script is:inline src="https://web3forms.com/client/script.js" async defer
></script>
