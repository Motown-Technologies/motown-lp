---
import { Image } from "astro:assets";
import Card from "../components/Card.astro";
import CardIcon from "../components/CardIcon.astro";
import CardTitle from "../components/CardTitle.astro";
import AutomationIcon from "../components/icons/AutomationIcon.astro";
import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import MarketingIcon from "../components/icons/MarketingIcon.astro";
import MobileIcon from "../components/icons/MobileIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import WebIcon from "../components/icons/WebIcon.astro";
import servicesData, { type Service } from "../data/services";
import heroImage from "../img/modern-technology-workspace-with-multiple-monitors.jpg";
import colabImage from "../img/professional-team-collaborating-on-technology-proj.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";

const ICONS: Record<string, any> = {
    software: SoftwareIcon,
    marketing: MarketingIcon,
    mobile: MobileIcon,
    automation: AutomationIcon,
    consulting: ConsultingIcon,
    web: WebIcon,
};

const toSlug = (text: string) =>
    text
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
---

<BaseLayout>
    <!-- Hero Section -->
    <section
        class="relative overflow-hidden bg-gradient-to-b from-[#f8fafc] via-[#eef2ff] to-[#f8fafc] pt-8 pb-32"
    >
        <div class="max-w-7xl mx-auto px-6">
            <!-- Hero Content -->
            <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
                <div>
                    <div class="inline-block mb-6">
                        <span
                            class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                            >Technology Solutions</span
                        >
                    </div>
                    <h1
                        class="text-6xl md:text-7xl lg:text-8xl font-bold text-slate-900 mb-8 leading-tight text-balance"
                    >
                        Where Ideas Become Reality
                    </h1>
                    <p
                        class="text-xl text-slate-600 leading-relaxed mb-10 text-pretty"
                    >
                        We transform your vision into powerful digital
                        solutions. From custom software to comprehensive digital
                        strategies, we're your partner in innovation and growth.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href="/contact"
                            class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors inline-flex items-center gap-2"
                        >
                            Start Your Project
                            <!-- ArrowRight -->
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                        <a
                            href="/services"
                            class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                        >
                            Explore Services
                        </a>
                    </div>
                </div>

                <div class="relative">
                    <div
                        class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                    >
                        <Image
                            src={heroImage}
                            alt="Technology Workspace"
                            class="w-full h-full object-cover opacity-80"
                        />
                    </div>
                    <!-- Floating Stats -->
                    <!-- <div
                        class="absolute -bottom-8 -left-8 bg-[#f1f5f9] border border-slate-200 rounded-xl p-6 backdrop-blur-sm"
                    >
                        <div class="text-4xl font-bold text-[#2563eb] mb-1">
                            100+
                        </div>
                        <div class="text-slate-600 text-sm">
                            Projects Delivered
                        </div>
                    </div>
                    <div
                        class="absolute -top-8 -right-8 bg-[#f1f5f9] border border-slate-200 rounded-xl p-6 backdrop-blur-sm"
                    >
                        <div class="text-4xl font-bold text-[#2563eb] mb-1">
                            50+
                        </div>
                        <div class="text-slate-600 text-sm">Happy Clients</div>
                    </div> -->
                </div>
            </div>
        </div>
    </section>

    <!-- Services Overview -->
    <section class="py-24 bg-[#f7f8fc]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-4">
                    What We Do Best
                </h2>
                <p class="text-xl text-slate-600 max-w-3xl mx-auto text-pretty">
                    Comprehensive technology solutions tailored to your business
                    needs
                </p>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-12">
                {
                    servicesData.map((svc: Service, idx: number) => {
                        const Icon = ICONS[svc.icon] ?? SoftwareIcon;

                        const toSlug = (s: string) =>
                            s
                                .toLowerCase()
                                .replace(/[^a-z0-9]+/g, "-")
                                .replace(/(^-|-$)/g, "");

                        const href = svc.href ?? "/" + toSlug(svc.title);

                        const spanClass =
                            idx < 2 ? "lg:col-span-6" : "lg:col-span-4";

                        return (
                            <Card
                                href={href}
                                class={spanClass}
                                aria-label={`${svc.title} – Learn more`}
                            >
                                <CardIcon>
                                    <Icon class="w-6 h-6 text-[#2563eb]" />
                                </CardIcon>
                                <CardTitle class="mb-3">{svc.title}</CardTitle>
                                <p class="text-slate-600 leading-relaxed mb-4">
                                    {svc.description}
                                </p>
                                {href && (
                                    <div class="flex items-center text-[#2563eb] font-semibold">
                                        Learn More
                                        <svg
                                            class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            aria-hidden="true"
                                        >
                                            <path d="M5 12h14" />
                                            <path d="m12 5 7 7-7 7" />
                                        </svg>
                                    </div>
                                )}
                            </Card>
                        );
                    })
                }
            </div>

            <div class="text-center mt-12">
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 text-[#2563eb] hover:text-[#1d4ed8] font-semibold text-lg transition-colors"
                >
                    View All Services
                    <svg
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 section-dark">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/10 to-transparent border border-[#2563eb]/20"
                    >
                        <Image
                            src={colabImage}
                            alt="Team Collaboration"
                            class="w-full h-full object-cover opacity-80"
                        />
                    </div>
                </div>

                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
                        Why Choose Motown Tech?
                    </h2>
                    <p
                        class="text-xl text-slate-600 mb-8 leading-relaxed text-pretty"
                    >
                        We combine technical expertise with creative innovation
                        to deliver solutions that exceed expectations
                    </p>

                    <div class="space-y-6">
                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <!-- Check -->
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">
                                    Expert Team
                                </h3>
                                <p class="text-slate-600 leading-relaxed">
                                    Skilled professionals with years of
                                    experience in cutting-edge technologies
                                </p>
                            </div>
                        </div>

                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">
                                    Proven Track Record
                                </h3>
                                <p class="text-slate-600 leading-relaxed">
                                    Successfully delivered projects across
                                    various industries
                                </p>
                            </div>
                        </div>

                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">
                                    Agile Approach
                                </h3>
                                <p class="text-slate-600 leading-relaxed">
                                    Flexible methodologies that adapt to your
                                    changing needs and priorities
                                </p>
                            </div>
                        </div>

                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-900 mb-2">
                                    Ongoing Support
                                </h3>
                                <p class="text-slate-600 leading-relaxed">
                                    Dedicated maintenance and support to ensure
                                    your success long-term
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 bg-gradient-to-b from-[#f8fafc] to-[#eef2ff]">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2
                class="text-4xl md:text-5xl font-bold text-slate-900 mb-6 text-balance"
            >
                Ready to Bring Your Ideas to Life?
            </h2>
            <p class="text-xl text-slate-600 mb-10 leading-relaxed text-pretty">
                Let's collaborate to create something extraordinary. Get in
                touch with our team today and start your journey to digital
                success.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href="/contact"
                    class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors inline-flex items-center gap-2"
                >
                    Contact Us
                    <svg
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
                <a
                    href="/services"
                    class="px-8 py-4 bg-transparent border-2 border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-100 transition-colors"
                >
                    Explore Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
