---
import { Image } from "astro:assets";
import heroImage from "../img/modern-technology-workspace-with-multiple-monitors.jpg";
import colabImage from "../img/professional-team-collaborating-on-technology-proj.jpg";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <!-- Hero Section -->
    <section
        class="relative overflow-hidden bg-gradient-to-b from-[#0a0a0f] via-[#1a1a2e] to-[#0a0a0f] pt-8 pb-32"
    >
        <div class="max-w-7xl mx-auto px-6">
            <!-- Hero Content -->
            <div class="grid lg:grid-cols-2 gap-16 items-center mb-24">
                <div>
                    <div class="inline-block mb-6">
                        <span
                            class="text-[#2563eb] text-sm font-semibold tracking-wider uppercase"
                            >Technology Solutions</span
                        >
                    </div>
                    <h1
                        class="text-6xl md:text-7xl lg:text-8xl font-bold text-white mb-8 leading-tight text-balance"
                    >
                        Where Ideas Become Reality
                    </h1>
                    <p
                        class="text-xl text-gray-400 leading-relaxed mb-10 text-pretty"
                    >
                        We transform your vision into powerful digital
                        solutions. From custom software to comprehensive digital
                        strategies, we're your partner in innovation and growth.
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <a
                            href="/contact"
                            class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors inline-flex items-center gap-2"
                        >
                            Start Your Project
                            <!-- ArrowRight -->
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                        <a
                            href="/services"
                            class="px-8 py-4 bg-transparent border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
                        >
                            Explore Services
                        </a>
                    </div>
                </div>

                <div class="relative">
                    <div
                        class="aspect-square rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                    >
                        <Image
                            src={heroImage}
                            alt="Technology Workspace"
                            class="w-full h-full object-cover opacity-80"
                        />
                    </div>
                    <!-- Floating Stats -->
                    <!-- <div
                        class="absolute -bottom-8 -left-8 bg-[#1a1a2e] border border-gray-800 rounded-xl p-6 backdrop-blur-sm"
                    >
                        <div class="text-4xl font-bold text-[#2563eb] mb-1">
                            100+
                        </div>
                        <div class="text-gray-400 text-sm">
                            Projects Delivered
                        </div>
                    </div>
                    <div
                        class="absolute -top-8 -right-8 bg-[#1a1a2e] border border-gray-800 rounded-xl p-6 backdrop-blur-sm"
                    >
                        <div class="text-4xl font-bold text-[#2563eb] mb-1">
                            50+
                        </div>
                        <div class="text-gray-400 text-sm">Happy Clients</div>
                    </div> -->
                </div>
            </div>
        </div>
    </section>

    <!-- Services Overview -->
    <section class="py-24 bg-[#0a0a0f]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
                    What We Do Best
                </h2>
                <p class="text-xl text-gray-400 max-w-3xl mx-auto text-pretty">
                    Comprehensive technology solutions tailored to your business
                    needs
                </p>
            </div>

            <!-- Services Overview -->
            <section class="py-24 bg-[#0a0a0f]">
                <div class="max-w-7xl mx-auto px-6">
                    <div class="text-center mb-16">
                        <h2
                            class="text-4xl md:text-5xl font-bold text-white mb-4"
                        >
                            What We Do Best
                        </h2>
                        <p
                            class="text-xl text-gray-400 max-w-3xl mx-auto text-pretty"
                        >
                            Comprehensive technology solutions tailored to your
                            business needs
                        </p>
                    </div>

                    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                        <!-- Software Development -->
                        <a
                            href="/software-development"
                            class="group bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 hover:border-[#2563eb]/50 transition-all hover:transform hover:scale-105"
                        >
                            <div
                                class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 group-hover:bg-[#2563eb]/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-bold text-white mb-3 group-hover:text-[#2563eb] transition-colors"
                            >
                                Software Development
                            </h3>
                            <p class="text-gray-400 leading-relaxed mb-4">
                                Custom applications built with cutting-edge
                                technologies to drive your business forward
                            </p>
                            <div
                                class="flex items-center text-[#2563eb] font-semibold"
                            >
                                Learn More
                                <svg
                                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>

                        <!-- Digital Marketing -->
                        <a
                            href="/digital-marketing"
                            class="group bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 hover:border-[#2563eb]/50 transition-all hover:transform hover:scale-105"
                        >
                            <div
                                class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 group-hover:bg-[#2563eb]/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-bold text-white mb-3 group-hover:text-[#2563eb] transition-colors"
                            >
                                Digital Marketing
                            </h3>
                            <p class="text-gray-400 leading-relaxed mb-4">
                                Strategic campaigns that increase visibility,
                                drive traffic, and convert leads
                            </p>
                            <div
                                class="flex items-center text-[#2563eb] font-semibold"
                            >
                                Learn More
                                <svg
                                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>

                        <!-- Mobile Development -->
                        <a
                            href="/mobile-app-development"
                            class="group bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 hover:border-[#2563eb]/50 transition-all hover:transform hover:scale-105"
                        >
                            <div
                                class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 group-hover:bg-[#2563eb]/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-bold text-white mb-3 group-hover:text-[#2563eb] transition-colors"
                            >
                                Mobile Development
                            </h3>
                            <p class="text-gray-400 leading-relaxed mb-4">
                                Intuitive mobile apps for iOS and Android that
                                engage users and drive results
                            </p>
                            <div
                                class="flex items-center text-[#2563eb] font-semibold"
                            >
                                Learn More
                                <svg
                                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>

                        <!-- Automation -->
                        <a
                            href="/automation"
                            class="group bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 hover:border-[#2563eb]/50 transition-all hover:transform hover:scale-105"
                        >
                            <div
                                class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 group-hover:bg-[#2563eb]/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-bold text-white mb-3 group-hover:text-[#2563eb] transition-colors"
                            >
                                Automation
                            </h3>
                            <p class="text-gray-400 leading-relaxed mb-4">
                                Streamline operations and reduce manual work
                                with intelligent automation solutions
                            </p>
                            <div
                                class="flex items-center text-[#2563eb] font-semibold"
                            >
                                Learn More
                                <svg
                                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>

                        <!-- Consulting -->
                        <a
                            href="/it-consulting"
                            class="group bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 hover:border-[#2563eb]/50 transition-all hover:transform hover:scale-105"
                        >
                            <div
                                class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 group-hover:bg-[#2563eb]/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-bold text-white mb-3 group-hover:text-[#2563eb] transition-colors"
                            >
                                Consulting
                            </h3>
                            <p class="text-gray-400 leading-relaxed mb-4">
                                Expert guidance to optimize your technology
                                strategy and drive business growth
                            </p>
                            <div
                                class="flex items-center text-[#2563eb] font-semibold"
                            >
                                Learn More
                                <svg
                                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>

                        <!-- Web Design & Development -->
                        <a
                            href="/web-design"
                            class="group bg-[#1a1a2e] rounded-xl p-8 border border-gray-800 hover:border-[#2563eb]/50 transition-all hover:transform hover:scale-105"
                        >
                            <div
                                class="w-12 h-12 bg-[#2563eb]/20 rounded-lg flex items-center justify-center mb-6 group-hover:bg-[#2563eb]/30 transition-colors"
                            >
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    aria-hidden="true"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"
                                    ></path>
                                </svg>
                            </div>
                            <h3
                                class="text-2xl font-bold text-white mb-3 group-hover:text-[#2563eb] transition-colors"
                            >
                                Web Design &amp; Development
                            </h3>
                            <p class="text-gray-400 leading-relaxed mb-4">
                                Beautiful, responsive websites that deliver
                                exceptional user experiences
                            </p>
                            <div
                                class="flex items-center text-[#2563eb] font-semibold"
                            >
                                Learn More
                                <svg
                                    class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </div>
                        </a>
                    </div>

                    <div class="text-center mt-12">
                        <a
                            href="/services"
                            class="inline-flex items-center gap-2 text-[#2563eb] hover:text-[#1d4ed8] font-semibold text-lg transition-colors"
                        >
                            View All Services
                            <svg
                                class="w-5 h-5"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14"></path>
                                <path d="m12 5 7 7-7 7"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </section>

            <div class="text-center mt-12">
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 text-[#2563eb] hover:text-[#1d4ed8] font-semibold text-lg transition-colors"
                >
                    View All Services
                    <svg
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
                        <path d="m12 5 7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="py-24 bg-[#1a1a2e]">
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-16 items-center">
                <div class="relative">
                    <div
                        class="aspect-[4/3] rounded-2xl overflow-hidden bg-gradient-to-br from-[#2563eb]/20 to-transparent border border-[#2563eb]/30"
                    >
                        <Image
                            src={colabImage}
                            alt="Team Collaboration"
                            class="w-full h-full object-cover opacity-80"
                        />
                    </div>
                </div>

                <div>
                    <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
                        Why Choose Motown Tech?
                    </h2>
                    <p
                        class="text-xl text-gray-400 mb-8 leading-relaxed text-pretty"
                    >
                        We combine technical expertise with creative innovation
                        to deliver solutions that exceed expectations
                    </p>

                    <div class="space-y-6">
                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <!-- Check -->
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-2">
                                    Expert Team
                                </h3>
                                <p class="text-gray-400 leading-relaxed">
                                    Skilled professionals with years of
                                    experience in cutting-edge technologies
                                </p>
                            </div>
                        </div>

                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-2">
                                    Proven Track Record
                                </h3>
                                <p class="text-gray-400 leading-relaxed">
                                    Successfully delivered 100+ projects across
                                    various industries
                                </p>
                            </div>
                        </div>

                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-2">
                                    Agile Approach
                                </h3>
                                <p class="text-gray-400 leading-relaxed">
                                    Flexible methodologies that adapt to your
                                    changing needs and priorities
                                </p>
                            </div>
                        </div>

                        <!-- Item -->
                        <div class="flex gap-4">
                            <div class="flex-shrink-0">
                                <svg
                                    class="w-6 h-6 text-[#2563eb]"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M20 6 9 17l-5-5"></path>
                                </svg>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white mb-2">
                                    Ongoing Support
                                </h3>
                                <p class="text-gray-400 leading-relaxed">
                                    Dedicated maintenance and support to ensure
                                    your success long-term
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-24 bg-gradient-to-b from-[#0a0a0f] to-[#1a1a2e]">
        <div class="max-w-4xl mx-auto px-6 text-center">
            <h2
                class="text-4xl md:text-5xl font-bold text-white mb-6 text-balance"
            >
                Ready to Bring Your Ideas to Life?
            </h2>
            <p class="text-xl text-gray-400 mb-10 leading-relaxed text-pretty">
                Let's collaborate to create something extraordinary. Get in
                touch with our team today and start your journey to digital
                success.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a
                    href="/contact"
                    class="px-8 py-4 bg-[#2563eb] text-white font-semibold rounded-lg hover:bg-[#1d4ed8] transition-colors inline-flex items-center gap-2"
                >
                    Contact Us
                    <svg
                        class="w-5 h-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="M5 12h14"></path>
