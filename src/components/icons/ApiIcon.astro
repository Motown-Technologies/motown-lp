    fill="none"
    stroke="currentColor"
    aria-hidden="true"
    stroke-width="2"
>
    <rect x="3" y="4" width="18" height="14" rx="2" ry="2"></rect>
    <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M8 9l3 3-3 3M13 15h3"></path>
</svg>
