---
const { class: className = "" } = Astro.props;

const baseClasses =
    "w-12 h-12 border-[1.5px] border-ink flex items-center justify-center mb-6 text-ink transition-colors duration-200 ease-out group-hover:border-paper group-hover:text-paper";
---

<div class={`${baseClasses} ${className}`.trim()}>
    <slot />
</div>
