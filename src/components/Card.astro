---
const {
    href,
    tag = "div",
    class: className = "",
    target,
    rel,
    ...rest
} = Astro.props;

const Tag = href ? "a" : tag;
const baseClasses =
    "group relative block h-full border-[1.5px] border-ink bg-paper p-8 transition-[transform,background-color,color] duration-200 hover:-translate-y-0.5 hover:bg-ink hover:text-paper focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-paper";
---

<Tag
    href={href}
    target={href ? target : undefined}
    rel={href ? rel : undefined}
    class={`${baseClasses} ${className}`.trim()}
    {...rest}
>
    <slot />
</Tag>
