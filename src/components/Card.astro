---
const {
    href,
    tag = "div",
    class: className = "",
    target,
    rel,
    ...rest
} = Astro.props;

const Tag = href ? "a" : tag;
const baseClasses =
    "group block h-full rounded-2xl border border-slate-200 bg-white p-8 shadow-[0_18px_40px_rgba(15,23,42,0.08)] transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/50 hover:shadow-[0_24px_50px_rgba(37,99,235,0.16)] focus:outline-none focus:ring-2 focus:ring-[#2563eb]/30";
---

<Tag
    href={href}
    target={href ? target : undefined}
    rel={href ? rel : undefined}
    class={`${baseClasses} ${className}`.trim()}
    {...rest}
>
    <slot />
</Tag>
