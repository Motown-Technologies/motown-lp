---
const {
    href,
    tag = "div",
    class: className = "",
    target,
    rel,
    ...rest
} = Astro.props;

const Tag = href ? "a" : tag;
const baseClasses =
    "group block h-full rounded-2xl border border-gray-800 bg-[#1a1a2e] p-8 shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-1 hover:border-[#2563eb]/60 hover:shadow-[0_25px_50px_rgba(37,99,235,0.2)] focus:outline-none focus:ring-2 focus:ring-[#2563eb]/60";
---

<Tag
    href={href}
    target={href ? target : undefined}
    rel={href ? rel : undefined}
    class={`${baseClasses} ${className}`.trim()}
    {...rest}
>
    <slot />
</Tag>
