---
import { ClientRouter } from "astro:transitions";
import { Navigation } from "../components/Navigation";

import "../styles/global.css";

import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

const { meta_title, meta_description, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{meta_title}</title>
        <meta name="description" content={meta_description} />
        {noindex && <meta name="robots" content="noindex" />}
        <ClientRouter />
        <style is:global>
            :root {
                color-scheme: light;
            }

            html {
                background-color: #f5f2ea;
            }

            body {
                font-feature-settings: "ss01", "cv11";
            }

            ::selection {
                background-color: #0b0b0c;
                color: #f5f2ea;
            }

            .section-ink {
                background-color: #0b0b0c;
                color: #f5f2ea;
            }

            .section-ink .text-ink {
                color: #f5f2ea;
            }

            .section-ink .text-ink-muted {
                color: #a1a1a6;
            }

            .section-ink .border-ink {
                border-color: #f5f2ea;
            }

            .section-ink .bg-paper,
            .section-ink .bg-paper-2 {
                background-color: #0b0b0c;
            }

            .section-ink .hover\:bg-ink:hover {
                background-color: #f5f2ea;
                color: #0b0b0c;
            }

            /* Scroll reveal: initial hidden state, revealed via data attr */
            [data-reveal] {
                opacity: 0;
                transform: translateY(8px);
                transition:
                    opacity 600ms ease,
                    transform 600ms ease;
                will-change: opacity, transform;
            }

            [data-reveal].is-revealed {
                opacity: 1;
                transform: none;
            }

            @media (prefers-reduced-motion: reduce) {
                [data-reveal] {
                    opacity: 1;
                    transform: none;
                    transition: none;
                }
            }

            /* Link underline draw — used on nav and inline links */
            .link-underline {
                background-image: linear-gradient(currentColor, currentColor);
                background-size: 0% 1.5px;
                background-repeat: no-repeat;
                background-position: 0 100%;
                transition: background-size 220ms ease;
            }

            .link-underline:hover,
            .link-underline:focus-visible {
                background-size: 100% 1.5px;
            }

            @media (prefers-reduced-motion: reduce) {
                .link-underline {
                    transition: none;
                }
            }
        </style>
    </head>
    <body class="font-sans bg-paper text-ink antialiased">
        <Navigation client:load />
        <slot />
        <!-- Footer -->
        <footer class="border-t-2 border-ink bg-paper">
            <div class="max-w-7xl mx-auto px-6 py-16">
                <div class="grid gap-10 grid-cols-2 md:grid-cols-12 lg:grid-cols-10">
                    <div class="col-span-2 md:col-span-12 lg:col-span-10">
                        <div class="font-display text-4xl md:text-5xl font-bold leading-none tracking-tight mb-4">
                            Motown Solutions
                        </div>
                        <p class="text-ink-muted max-w-md leading-relaxed">
                            Where ideas become reality. Custom software, web,
                            mobile, automation, and consulting for teams with
                            ambition.
                        </p>
                    </div>
                    <div class="col-span-1 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — Sitemap
                        </div>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="/"
                                    class="link-underline font-medium"
                                    >Home</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/about"
                                    class="link-underline font-medium"
                                    >About</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services"
                                    class="link-underline font-medium"
                                    >Services</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/contact"
                                    class="link-underline font-medium"
                                    >Contact</a
                                >
                            </li>
                        </ul>
                    </div>
                    <div class="col-span-1 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — Services
                        </div>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="/services/software-development"
                                    class="link-underline font-medium"
                                    >Software</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/ai-development"
                                    class="link-underline font-medium"
                                    >AI</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/web-design"
                                    class="link-underline font-medium"
                                    >Web</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/mobile-development"
                                    class="link-underline font-medium"
                                    >Mobile</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/automation"
                                    class="link-underline font-medium"
                                    >Automation</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/consulting"
                                    class="link-underline font-medium"
                                    >Consulting</a
                                >
                            </li>
                        </ul>
                    </div>
                    <div class="col-span-2 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — What We Build
                        </div>
                        <ul class="space-y-2">
                            {
                                [
                                    ["/startup-consulting", "Startup Consulting"],
                                    ["/mvp-development", "MVP Development"],
                                    ["/fractional-cto", "Fractional CTO"],
                                    [
                                        "/technical-due-diligence",
                                        "Technical Due Diligence",
                                    ],
                                    [
                                        "/prototype-to-production",
                                        "Prototype to Production",
                                    ],
                                    [
                                        "/ecommerce-development",
                                        "Ecommerce Development",
                                    ],
                                    ["/shopify-development", "Shopify Development"],
                                    [
                                        "/headless-commerce-development",
                                        "Headless Commerce",
                                    ],
                                ].map(([href, label]) => (
                                    <li>
                                        <a
                                            href={href}
                                            class="link-underline font-medium"
                                        >
                                            {label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="col-span-2 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — Case Studies
                        </div>
                        <ul class="space-y-2">
                            {
                                [
                                    [
                                        "/case-studies/healthcare-practice",
                                        "Multi-Site Healthcare Practice",
                                    ],
                                    [
                                        "/case-studies/auction-operations",
                                        "Auction House Operations",
                                    ],
                                    [
                                        "/case-studies/senior-care-concierge",
                                        "Senior Care Concierge",
                                    ],
                                    [
                                        "/case-studies/endoscopy-center",
                                        "Headless WordPress Rebuild",
                                    ],
                                    [
                                        "/case-studies/nonprofit-community",
                                        "Nonprofit Community Platform",
                                    ],
                                    [
                                        "/case-studies/donation-platform",
                                        "Multi-Tenant Donation Platform",
                                    ],
                                ].map(([href, label]) => (
                                    <li>
                                        <a
                                            href={href}
                                            class="link-underline font-medium"
                                        >
                                            {label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
                <div class="mt-14 pt-6 border-t border-ink/20 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                    <p class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted">
                        &copy; 2025 Motown Solutions — Where Ideas Become Reality
                    </p>
                    <div class="flex items-center gap-5 font-mono text-xs uppercase tracking-eyebrow text-ink-muted">
                        <a href="/terms" class="link-underline">Terms</a>
                        <span aria-hidden>·</span>
                        <a href="/privacy" class="link-underline">Privacy</a>
                    </div>
                </div>
            </div>
        </footer>

        <script is:inline>
            (() => {
                const reveal = () => {
                    const els = document.querySelectorAll("[data-reveal]");
                    if (!("IntersectionObserver" in window)) {
                        els.forEach((el) => el.classList.add("is-revealed"));
                        return;
                    }
                    const io = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("is-revealed");
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
                    );
                    els.forEach((el) => io.observe(el));
                };
                reveal();
                document.addEventListener("astro:page-load", reveal);
            })();
        </script>
    </body>
</html>
