---
import { ClientRouter } from "astro:transitions";
import { Navigation } from "../components/Navigation";
const { meta_title, meta_description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{meta_title}</title>
        <meta name="description" content={meta_description} />
        <ClientRouter />
        <style is:global>
            :root {
                color-scheme: light;
            }

            .section-dark {
                background-color: #0f172a;
                color: #e2e8f0;
            }

            .section-dark .text-slate-900 {
                color: #f8fafc;
            }

            .section-dark .text-slate-700 {
                color: #e2e8f0;
            }

            .section-dark .text-slate-600 {
                color: #cbd5f5;
            }

            .section-dark .text-slate-500 {
                color: #94a3b8;
            }

            .section-dark .text-slate-400 {
                color: #94a3b8;
            }

            .section-dark .border-slate-200 {
                border-color: rgba(148, 163, 184, 0.22);
            }

            .section-dark .border-slate-300 {
                border-color: rgba(148, 163, 184, 0.38);
            }

            .section-dark .bg-white,
            .section-dark .bg-\[\#f7f8fc\],
            .section-dark .bg-\[\#f1f5f9\] {
                background-color: #111827;
            }

            .section-dark .hover\:bg-slate-100:hover {
                background-color: rgba(148, 163, 184, 0.12);
            }
        </style>
    </head>
    <body class="pt-28 bg-[#f7f8fc] text-slate-900">
        <Navigation client:load />
        <slot />
        <!-- Footer -->
        <footer class="py-8 bg-[#f7f8fc] border-t border-slate-200">
            <div class="max-w-7xl mx-auto px-6 text-center text-slate-500">
                <p>&copy; 2025 Motown Tech. Where Ideas Become Reality.</p>
            </div>
        </footer>
    </body>
</html>
